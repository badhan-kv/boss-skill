{
  "statusLine": {
    "type": "command",
    "command": "bash \"$HOME/.claude/skills/boss/scripts/run-for-os.sh\" statusline"
  },
  "hooks": {
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/skills/boss/scripts/run-for-os.sh\" notify-boss needs-user"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "elicitation_dialog|elicitation_url_dialog",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/skills/boss/scripts/run-for-os.sh\" notify-boss needs-user"
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/skills/boss/scripts/run-for-os.sh\" notify-boss api-error"
          }
        ]
      }
    ]
  }
}
